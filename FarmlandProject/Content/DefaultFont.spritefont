<?xml version="1.0" encoding="utf-8"?>
<!--
This file defines the font used by the MonoGame pixel-style interface.
-->
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
	<FontName>Arial</FontName>
	<Size>18</Size>
	<Spacing>0</Spacing>
	<UseKerning>true</UseKerning>
	<Style>Regular</Style>
	<CharacterRegions>
	  <CharacterRegion>
		<Start>&#32;</Start>
		<End>~</End>
	  </CharacterRegion>
	</CharacterRegions>
  </Asset>
</XnaContent>